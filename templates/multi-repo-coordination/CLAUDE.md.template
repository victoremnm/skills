## Common Commands

```bash
# Check status across all repos
for d in */; do echo "=== $d ===" && git -C "$d" status -sb 2>/dev/null; done

# Pull all repos
for d in */; do git -C "$d" pull 2>/dev/null; done

# Find uncommitted changes
for d in */; do
  changes=$(git -C "$d" status --porcelain 2>/dev/null | wc -l)
  [ "$changes" -gt 0 ] && echo "$d: $changes uncommitted"
done
```

